{
  "name": "grt-bus-time",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:free": "tsc --noEmit && vite build --mode free",
    "build:release": "npm run build",
    "build:all": "npm run build && npm run build:free",
    "watch": "vite build --watch",
    "zip": "npm run build && node scripts/package.mjs",
    "zip:free": "npm run build:free && node scripts/package.mjs --free",
    "zip:all": "npm run zip && npm run zip:free",
    "clean": "node -e \"for (const d of ['dist','dist-free','artifacts']) fs.rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run typecheck && npm run test && npm run build:all",
    "dev": "vite"
  },
  "dependencies": {
    "extpay": "3.1.2",
    "fflate": "^0.8.2",
    "gtfs-realtime-bindings": "^2.1.0",
    "idb": "^8.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
