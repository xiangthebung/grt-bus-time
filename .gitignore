node_modules/

# Build output. Both channels are generated by `npm run build` / `npm run build:free`
# and must never be committed: a stale committed `dist/` shipped a manifest that
# requested the `offscreen` permission while the offscreen document itself was
# missing, which is not loadable.
dist/
dist-free/

# The Pro build is also synced into the repository root so a GitHub source
# download can be loaded directly by Chrome. Those root files are intentional.

# Store upload artifacts, produced by `npm run zip`.
artifacts/
*.zip

# Secrets. Only the example file is tracked.
.env
.env.*
!.env.example

.DS_Store
*.log

# Everything written for an assistant rather than for the project: the running
# notes in ai/NOTES.md, the standing instructions in ai/README.md, and whatever
# throwaway probes a session leaves behind. None of it is reviewed, none of it
# should be, and it carries absolute paths and dates from whichever machine it was
# written on.
#
# What belongs in the repository instead: anything true about the project rather
# than about the work of changing it. Put that in a comment beside the code, or in
# README.md if a user needs it.
ai/
