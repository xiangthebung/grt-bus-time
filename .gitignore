node_modules/

# Build output. Both channels are generated by `npm run build` / `npm run build:free`
# and must never be committed: a stale committed `dist/` shipped a manifest that
# requested the `offscreen` permission while the offscreen document itself was
# missing, which is not loadable.
dist/
dist-free/

# Store upload artifacts, produced by `npm run zip`.
artifacts/
*.zip

# Secrets. Only the example file is tracked.
.env
.env.*
!.env.example

.DS_Store
*.log
