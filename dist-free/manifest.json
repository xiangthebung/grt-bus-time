{
  "manifest_version": 3,
  "name": "GRT Next Bus Free",
  "version": "1.0.0",
  "description": "See the next three Grand River Transit departures for your saved stops.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webapps.regionofwaterloo.ca/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GRT Next Bus Free",
    "default_popup": "popup.html"
  }
}